<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Playground.Xaml"
             xmlns:sys="using:System"
             mc:Ignorable="d"
             x:Class="Playground.Xaml.MyNestedControl">

    <UserControl.DataContext>
        <Binding Path="ViewModel" RelativeSource="{RelativeSource Self}" />
    </UserControl.DataContext>

    <StackPanel>
        <TextBox Text="{Binding FactoryValue, Mode=OneWay}" />
        <Button Click="OnClick" Content="Factory Value" />
    </StackPanel>
</UserControl>