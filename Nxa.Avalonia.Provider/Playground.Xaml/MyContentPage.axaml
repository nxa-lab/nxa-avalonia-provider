<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:prov="clr-namespace:Nxa.Avalonia.Provider;assembly=Nxa.Avalonia.Provider"
             xmlns:local="clr-namespace:Playground.Xaml;assembly=Playground.Xaml"
             x:Class="Playground.Xaml.MyContentPage">
  <prov:ProviderHost x:Name="Provider">
    <local:MyNestedControl />
  </prov:ProviderHost>
</ContentPage>
